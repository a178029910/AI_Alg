  <text x="496" y="90" text-anchor="middle" font-size="11.5" fill="#92400e" font-weight="700" data-page-node-id="7Doc5v3RCdQpSCVMUYTGK2">预测器 q_θ</text>
  <text x="496" y="110" text-anchor="middle" font-size="10" fill="#475569" data-page-node-id="YUNucXHy6iW1M42gbzhhqr">仅在线侧有</text>
  <!-- target branch -->
  <line x1="256" y1="237" x2="292" y2="237" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#ssl-ar)" data-page-node-id="FG1pM5XkeZqXwmvtgHhqoN"/>
  <rect x="296" y="204" width="104" height="66" rx="8" fill="#eff6ff" stroke="#2563eb" stroke-width="1.6" data-page-node-id="kdGcoxGxl5dDcxPqckUclG"/>
  <text x="348" y="228" text-anchor="middle" font-size="11" fill="#1d4ed8" font-weight="700" data-page-node-id="w6uDnB6lBgxxMDTzuDN22q">目标网络 ξ</text>
