  <!-- v2 -->
  <rect x="310" y="52" width="250" height="240" rx="10" fill="#ecfdf5" stroke="#059669" stroke-width="1.7" data-page-node-id="c04hGSMIWqk5YX75Rm07ki"/>
  <text x="435" y="78" text-anchor="middle" font-size="13.5" fill="#047857" font-weight="700" data-page-node-id="yvDQTLsKBPOdK0vFZxcwzo">DINO v2（2023.04）</text>
  <text x="435" y="98" text-anchor="middle" font-size="10.5" fill="#475569" data-page-node-id="DaAl74afCeAcGBPy00IXWE">把方法做成基础设施</text>
