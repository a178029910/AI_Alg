  <text x="450" y="214" text-anchor="middle" font-size="10.5" fill="#475569" data-page-node-id="YWr5H4eWxZFAHfem8qf063">从数据本身构造监督信号</text>
  <!-- 1 -->
  <rect x="48" y="52" width="212" height="96" rx="9" fill="#f5f3ff" stroke="#7c3aed" stroke-width="1.6" data-page-node-id="AI54BWRqAoIAODVXiqFt8c"/>
