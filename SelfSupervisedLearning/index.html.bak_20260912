  <text x="128" y="234" text-anchor="middle" font-size="10.5" fill="#7c3aed" font-weight="700" data-page-node-id="0Lg9G8VEYUuYMWd6kfmZeI">学到：物体级语义</text>
  <text x="128" y="254" text-anchor="middle" font-size="10" fill="#94a3b8" data-page-node-id="Y4iZEUXc2tteBlxtTYQfvZ">草是绿的、天是蓝的</text>
  <!-- 2 jigsaw -->
  <rect x="238" y="50" width="196" height="230" rx="10" fill="#ecfdf5" stroke="#059669" stroke-width="1.6" data-page-node-id="6cpRDlORRxfmFbNFObV3ke"/>
