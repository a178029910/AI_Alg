<tr><th>领域</th><th>应用</th><th>状态</th><th>转移</th></tr>
<tr><td>生物信息学</td><td>基因序列分析</td><td>编码区/非编码区</td><td>序列变化</td></tr>
<tr><td>金融</td><td>市场状态建模</td><td>牛市/熊市/震荡</td><td>市场转换</td></tr>
