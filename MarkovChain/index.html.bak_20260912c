<section id="ch12">
<h2><span class="num">12</span>Python 代码实现</h2>

<h3>12.1 离散马尔科夫链模拟</h3>
<div class="code-block">
<div class="code-header">markov_chain.py</div>
<pre>
<span class="kw">import</span> <span class="cls">numpy</span> <span class="kw">as</span> <span class="cls">np</span>

<span class="kw">class</span> <span class="cls">MarkovChain</span>:
    <span class="str">"""离散时间马尔科夫链"""</span>
    <span class="kw">def</span> __init__(<span class="kw">self</span>, P, states=<span class="kw">None</span>):
        <span class="kw">self</span>.P = <span class="cls">np</span>.<span class="fn">array</span>(P, dtype=<span class="fn">float</span>)
        <span class="kw">self</span>.n_states = <span class="fn">len</span>(P)
        <span class="kw">self</span>.states = states <span class="kw">or</span> <span class="fn">list</span>(<span class="fn">range</span>(<span class="kw">self</span>.n_states))

    <span class="kw">def</span> <span class="fn">simulate</span>(<span class="kw">self</span>, n_steps, start_state=<span class="kw">None</span>, seed=<span class="kw">None</span>):
        <span class="str">"""模拟马尔科夫链轨迹"""</span>
        rng = <span class="cls">np</span>.<span class="fn">random</span>.RandomState(seed)
        path = []
        current = start_state <span class="kw">if</span> start_state <span class="kw">is</span> <span class="kw">not</span> <span class="kw">None</span> <span class="kw">else</span> rng.<span class="fn">choice</span>(<span class="kw">self</span>.n_states)
        <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(n_steps):
            path.<span class="fn">append</span>(current)
            current = rng.<span class="fn">choice</span>(<span class="kw">self</span>.n_states, p=<span class="kw">self</span>.P[current])
        <span class="kw">return</span> [<span class="kw">self</span>.states[i] <span class="kw">for</span> i <span class="kw">in</span> path]

    <span class="kw">def</span> <span class="fn">stationary_distribution</span>(<span class="kw">self</span>):
        <span class="str">"""求解平稳分布 pi = pi @ P"""</span>
        <span class="com"># 解 (P^T - I) pi = 0, sum(pi) = 1</span>
        A = (<span class="kw">self</span>.P.<span class="fn">T</span> - <span class="cls">np</span>.<span class="fn">eye</span>(<span class="kw">self</span>.n_states))
        A[-<span class="num">1</span>] = <span class="cls">np</span>.<span class="fn">ones</span>(<span class="kw">self</span>.n_states)
        b = <span class="cls">np</span>.<span class="fn">zeros</span>(<span class="kw">self</span>.n_states)
        b[-<span class="num">1</span>] = <span class="num">1</span>
        <span class="kw">return</span> <span class="cls">np</span>.linalg.<span class="fn">solve</span>(A, b)

    <span class="kw">def</span> <span class="fn">n_step_transition</span>(<span class="kw">self</span>, n):
        <span class="str">"""n 步转移矩阵 P^n"""</span>
        <span class="kw">return</span> <span class="cls">np</span>.linalg.<span class="fn">matrix_power</span>(<span class="kw">self</span>.P, n)

<span class="com"># 天气模型</span>
P = [[<span class="num">0.7</span>, <span class="num">0.2</span>, <span class="num">0.1</span>], [<span class="num">0.3</span>, <span class="num">0.4</span>, <span class="num">0.3</span>], [<span class="num">0.2</span>, <span class="num">0.3</span>, <span class="num">0.5</span>]]
mc = <span class="cls">MarkovChain</span>(P, states=[<span class="str">"晴"</span>, <span class="str">"阴"</span>, <span class="str">"雨"</span>])
<span class="fn">print</span>(<span class="str">"平稳分布:"</span>, mc.<span class="fn">stationary_distribution</span>())
<span class="fn">print</span>(<span class="str">"3步转移:"</span>, mc.<span class="fn">n_step_transition</span>(<span class="num">3</span>))
<span class="fn">print</span>(<span class="str">"模拟7天:"</span>, mc.<span class="fn">simulate</span>(<span class="num">7</span>, start_state=<span class="num">0</span>, seed=<span class="num">42</span>))
</pre>
</div>

<h3>12.2 HMM 前向算法 + Viterbi</h3>
<div class="code-block">
<div class="code-header">hmm.py</div>
<pre>
<span class="kw">import</span> <span class="cls">numpy</span> <span class="kw">as</span> <span class="cls">np</span>

<span class="kw">class</span> <span class="cls">HMM</span>:
    <span class="str">"""隐马尔科夫模型"""</span>
    <span class="kw">def</span> __init__(<span class="kw">self</span>, A, B, pi):
        <span class="kw">self</span>.A = <span class="cls">np</span>.<span class="fn">array</span>(A)  <span class="com"># 转移矩阵 N×N</span>
        <span class="kw">self</span>.B = <span class="cls">np</span>.<span class="fn">array</span>(B)  <span class="com"># 发射矩阵 N×M</span>
        <span class="kw">self</span>.pi = <span class="cls">np</span>.<span class="fn">array</span>(pi) <span class="com"># 初始分布 N</span>
        <span class="kw">self</span>.N = <span class="fn">len</span>(A)
        <span class="kw">self</span>.M = <span class="fn">len</span>(B[<span class="num">0</span>])

    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, obs):
        <span class="str">"""前向算法：P(O|lambda)"""</span>
        <span class="fn">T</span> = <span class="fn">len</span>(obs)
        alpha = <span class="cls">np</span>.<span class="fn">zeros</span>((<span class="fn">T</span>, <span class="kw">self</span>.N))
        alpha[<span class="num">0</span>] = <span class="kw">self</span>.pi * <span class="kw">self</span>.B[:, obs[<span class="num">0</span>]]
        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="num">1</span>, <span class="fn">T</span>):
            <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(<span class="kw">self</span>.N):
                alpha[t, j] = <span class="cls">np</span>.<span class="fn">sum</span>(alpha[t-<span class="num">1</span>] * <span class="kw">self</span>.A[:, j]) * <span class="kw">self</span>.B[j, obs[t]]
        <span class="kw">return</span> alpha, alpha[-<span class="num">1</span>].<span class="fn">sum</span>()

    <span class="kw">def</span> <span class="fn">viterbi</span>(<span class="kw">self</span>, obs):
        <span class="str">"""Viterbi 算法：最优状态序列"""</span>
        <span class="fn">T</span> = <span class="fn">len</span>(obs)
        delta = <span class="cls">np</span>.<span class="fn">zeros</span>((<span class="fn">T</span>, <span class="kw">self</span>.N))
        psi = <span class="cls">np</span>.<span class="fn">zeros</span>((<span class="fn">T</span>, <span class="kw">self</span>.N), dtype=<span class="fn">int</span>)
        delta[<span class="num">0</span>] = <span class="kw">self</span>.pi * <span class="kw">self</span>.B[:, obs[<span class="num">0</span>]]
        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="num">1</span>, <span class="fn">T</span>):
            <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(<span class="kw">self</span>.N):
                probs = delta[t-<span class="num">1</span>] * <span class="kw">self</span>.A[:, j]
                psi[t, j] = <span class="cls">np</span>.<span class="fn">argmax</span>(probs)
                delta[t, j] = probs[psi[t, j]] * <span class="kw">self</span>.B[j, obs[t]]
        <span class="com"># 回溯</span>
        path = [<span class="cls">np</span>.<span class="fn">argmax</span>(delta[-<span class="num">1</span>])]
        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">T</span>-<span class="num">2</span>, -<span class="num">1</span>, -<span class="num">1</span>):
            path.<span class="fn">append</span>(psi[t+<span class="num">1</span>, path[-<span class="num">1</span>]])
        path.reverse()
        <span class="kw">return</span> path

    <span class="kw">def</span> <span class="fn">backward</span>(<span class="kw">self</span>, obs):
        <span class="str">"""后向算法"""</span>
        <span class="fn">T</span> = <span class="fn">len</span>(obs)
        beta = <span class="cls">np</span>.<span class="fn">zeros</span>((<span class="fn">T</span>, <span class="kw">self</span>.N))
        beta[-<span class="num">1</span>] = <span class="num">1.0</span>
        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">T</span>-<span class="num">2</span>, -<span class="num">1</span>, -<span class="num">1</span>):
            <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(<span class="kw">self</span>.N):
                beta[t, i] = <span class="cls">np</span>.<span class="fn">sum</span>(<span class="kw">self</span>.A[i] * <span class="kw">self</span>.B[:, obs[t+<span class="num">1</span>]] * beta[t+<span class="num">1</span>])
        <span class="kw">return</span> beta
</pre>
</div>

<h3>12.3 Baum-Welch 参数学习</h3>
<div class="code-block">
<div class="code-header">baum_welch.py</div>
<pre>
<span class="kw">import</span> <span class="cls">numpy</span> <span class="kw">as</span> <span class="cls">np</span>

<span class="kw">def</span> <span class="fn">baum_welch</span>(obs, N, M, max_iter=<span class="num">100</span>, tol=<span class="num">1e-4</span>):
    <span class="str">"""Baum-Welch 算法：EM 估计 HMM 参数"""</span>
    <span class="fn">T</span> = <span class="fn">len</span>(obs)
    <span class="com"># 随机初始化</span>
    A = <span class="cls">np</span>.<span class="fn">random</span>.<span class="fn">dirichlet</span>(<span class="cls">np</span>.<span class="fn">ones</span>(N), size=N)
    B = <span class="cls">np</span>.<span class="fn">random</span>.<span class="fn">dirichlet</span>(<span class="cls">np</span>.<span class="fn">ones</span>(M), size=N)
    pi = <span class="cls">np</span>.<span class="fn">random</span>.<span class="fn">dirichlet</span>(<span class="cls">np</span>.<span class="fn">ones</span>(N))

    <span class="kw">for</span> iteration <span class="kw">in</span> <span class="fn">range</span>(max_iter):
        <span class="com"># E 步：前向-后向</span>
        alpha = <span class="cls">np</span>.<span class="fn">zeros</span>((<span class="fn">T</span>, N))
        beta = <span class="cls">np</span>.<span class="fn">zeros</span>((<span class="fn">T</span>, N))
        alpha[<span class="num">0</span>] = pi * B[:, obs[<span class="num">0</span>]]
        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="num">1</span>, <span class="fn">T</span>):
            <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(N):
                alpha[t, j] = <span class="cls">np</span>.<span class="fn">sum</span>(alpha[t-<span class="num">1</span>] * A[:, j]) * B[j, obs[t]]
        beta[-<span class="num">1</span>] = <span class="num">1.0</span>
        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">T</span>-<span class="num">2</span>, -<span class="num">1</span>, -<span class="num">1</span>):
            <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(N):
                beta[t, i] = <span class="cls">np</span>.<span class="fn">sum</span>(A[i] * B[:, obs[t+<span class="num">1</span>]] * beta[t+<span class="num">1</span>])

        <span class="com"># gamma 和 xi</span>
        gamma = alpha * beta / (alpha * beta).<span class="fn">sum</span>(axis=<span class="num">1</span>, keepdims=<span class="kw">True</span>)
        xi = <span class="cls">np</span>.<span class="fn">zeros</span>((<span class="fn">T</span>-<span class="num">1</span>, N, N))
        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">T</span>-<span class="num">1</span>):
            denom = <span class="cls">np</span>.<span class="fn">sum</span>(alpha[t][:, <span class="kw">None</span>] * A * B[:, obs[t+<span class="num">1</span>]] * beta[t+<span class="num">1</span>])
            xi[t] = alpha[t][:, <span class="kw">None</span>] * A * B[:, obs[t+<span class="num">1</span>]] * beta[t+<span class="num">1</span>] / denom

        <span class="com"># M 步：更新参数</span>
        pi_new = gamma[<span class="num">0</span>]
        A_new = xi.<span class="fn">sum</span>(<span class="num">0</span>) / gamma[:-<span class="num">1</span>].<span class="fn">sum</span>(<span class="num">0</span>)[:, <span class="kw">None</span>]
        B_new = <span class="cls">np</span>.zeros_like(B)
        <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(M):
            mask = <span class="cls">np</span>.<span class="fn">array</span>(obs[:-<span class="num">1</span>]) == k
            B_new[:, k] = gamma[:-<span class="num">1</span>][mask].<span class="fn">sum</span>(<span class="num">0</span>) / gamma[:-<span class="num">1</span>].<span class="fn">sum</span>(<span class="num">0</span>)

        <span class="com"># 检查收敛</span>
        <span class="kw">if</span> <span class="cls">np</span>.<span class="fn">abs</span>(A_new - A).<span class="fn">max</span>() < tol:
            <span class="kw">break</span>
        A, B, pi = A_new, B_new, pi_new

    <span class="kw">return</span> A, B, pi
</pre>
</div>

<h3>12.4 Metropolis-Hastings 采样</h3>
<div class="code-block">
<div class="code-header">metropolis.py</div>
<pre>
<span class="kw">import</span> <span class="cls">numpy</span> <span class="kw">as</span> <span class="cls">np</span>

<span class="kw">def</span> <span class="fn">metropolis_hastings</span>(target_log_pdf, x0, n_samples=<span class="num">10000</span>,
                         proposal_std=<span class="num">1.0</span>, burn_in=<span class="num">1000</span>):
    <span class="str">"""Metropolis-Hastings 采样器
    target_log_pdf: 目标分布的对数密度（无需归一化）
    """</span>
    samples = []
    x = x0
    log_p = target_log_pdf(x0)
    n_accept = <span class="num">0</span>
    rng = <span class="cls">np</span>.<span class="fn">random</span>.RandomState(<span class="num">42</span>)

    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(n_samples + burn_in):
        <span class="com"># 对称高斯提议</span>
        x_proposal = x + rng.<span class="fn">normal</span>(<span class="num">0</span>, proposal_std)
        log_p_proposal = target_log_pdf(x_proposal)
        <span class="com"># 接受概率</span>
        log_alpha = log_p_proposal - log_p
        <span class="kw">if</span> <span class="cls">np</span>.<span class="fn">log</span>(rng.<span class="fn">uniform</span>()) < log_alpha:
            x = x_proposal
            log_p = log_p_proposal
            n_accept += <span class="num">1</span>
        <span class="kw">if</span> i >= burn_in:
            samples.<span class="fn">append</span>(x)

    accept_rate = n_accept / (n_samples + burn_in)
    <span class="kw">return</span> <span class="cls">np</span>.<span class="fn">array</span>(samples), accept_rate

<span class="com"># 示例：从双峰分布采样</span>
<span class="kw">def</span> <span class="fn">bimodal_log_pdf</span>(x):
    <span class="kw">return</span> <span class="cls">np</span>.<span class="fn">log</span>(<span class="cls">np</span>.<span class="fn">exp</span>(-<span class="num">0.5</span>*(x-<span class="num">3</span>)**<span class="num">2</span>) + <span class="cls">np</span>.<span class="fn">exp</span>(-<span class="num">0.5</span>*(x+<span class="num">3</span>)**<span class="num">2</span>))

samples, rate = <span class="fn">metropolis_hastings</span>(<span class="fn">bimodal_log_pdf</span>, x0=<span class="num">0</span>, n_samples=<span class="num">5000</span>)
<span class="fn">print</span>(f<span class="str">"接受率: {rate:.3f}"</span>)
<span class="fn">print</span>(f<span class="str">"样本均值: {samples.mean():.3f}, 标准差: {samples.std():.3f}"</span>)
</pre>
</div>

<h3>12.5 Gibbs 采样器</h3>
<div class="code-block">
<div class="code-header">gibbs.py</div>
<pre>
<span class="kw">import</span> <span class="cls">numpy</span> <span class="kw">as</span> <span class="cls">np</span>

<span class="kw">def</span> <span class="fn">gibbs_sampler</span>(bivariate_normal, x0, n_samples=<span class="num">5000</span>, burn_in=<span class="num">1000</span>):
    <span class="str">"""二维正态分布的 Gibbs 采样器
    bivariate_normal: (mu, Sigma) 参数
    """</span>
    mu, Sigma = bivariate_normal
    total = n_samples + burn_in
    samples = <span class="cls">np</span>.<span class="fn">zeros</span>((total, <span class="num">2</span>))
    x = <span class="cls">np</span>.<span class="fn">array</span>(x0, dtype=<span class="fn">float</span>)
    sigma1, sigma2 = <span class="cls">np</span>.<span class="fn">sqrt</span>(Sigma[<span class="num">0</span>,<span class="num">0</span>]), <span class="cls">np</span>.<span class="fn">sqrt</span>(Sigma[<span class="num">1</span>,<span class="num">1</span>])
    rho = Sigma[<span class="num">0</span>,<span class="num">1</span>] / (sigma1 * sigma2)

    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(total):
        <span class="com"># 采样 x1 | x2</span>
        cond_mean1 = mu[<span class="num">0</span>] + rho * sigma1 / sigma2 * (x[<span class="num">1</span>] - mu[<span class="num">1</span>])
        cond_std1 = sigma1 * <span class="cls">np</span>.<span class="fn">sqrt</span>(<span class="num">1</span> - rho**<span class="num">2</span>)
        x[<span class="num">0</span>] = <span class="cls">np</span>.<span class="fn">random</span>.<span class="fn">normal</span>(cond_mean1, cond_std1)
        <span class="com"># 采样 x2 | x1</span>
        cond_mean2 = mu[<span class="num">1</span>] + rho * sigma2 / sigma1 * (x[<span class="num">0</span>] - mu[<span class="num">0</span>])
        cond_std2 = sigma2 * <span class="cls">np</span>.<span class="fn">sqrt</span>(<span class="num">1</span> - rho**<span class="num">2</span>)
        x[<span class="num">1</span>] = <span class="cls">np</span>.<span class="fn">random</span>.<span class="fn">normal</span>(cond_mean2, cond_std2)
        samples[i] = x

    <span class="kw">return</span> samples[burn_in:]

<span class="com"># 示例</span>
mu = [<span class="num">0</span>, <span class="num">0</span>]
Sigma = [[<span class="num">1</span>, <span class="num">0.8</span>], [<span class="num">0.8</span>, <span class="num">1</span>]]
samples = <span class="fn">gibbs_sampler</span>((mu, Sigma), x0=[<span class="num">0</span>, <span class="num">0</span>])
<span class="fn">print</span>(f<span class="str">"样本均值: {samples.mean(axis=0)}"</span>)
<span class="fn">print</span>(f<span class="str">"样本协方差:\n{np.cov(samples.T)}"</span>)
</pre>
</div>

<h3>12.6 PageRank 计算</h3>
<div class="code-block">
<div class="code-header">pagerank.py</div>
<pre>
<span class="kw">import</span> <span class="cls">numpy</span> <span class="kw">as</span> <span class="cls">np</span>

<span class="kw">def</span> <span class="fn">pagerank</span>(adj_matrix, d=<span class="num">0.85</span>, max_iter=<span class="num">100</span>, tol=<span class="num">1e-6</span>):
    <span class="str">"""PageRank 算法
    adj_matrix: 邻接矩阵 A[i][j]=1 表示 i→j 有链接
    d: 阻尼因子（继续浏览概率）
    """</span>
    N = <span class="fn">len</span>(adj_matrix)
    <span class="com"># 归一化为转移矩阵</span>
    row_sums = adj_matrix.<span class="fn">sum</span>(axis=<span class="num">1</span>, keepdims=<span class="kw">True</span>)
    row_sums[row_sums == <span class="num">0</span>] = <span class="num">1</span>  <span class="com"># 处理悬挂节点</span>
    P = adj_matrix / row_sums
    <span class="com"># 加入阻尼因子</span>
    P_pr = d * P + (<span class="num">1</span> - d) / N * <span class="cls">np</span>.<span class="fn">ones</span>((N, N))

    <span class="com"># 幂迭代求平稳分布</span>
    pi = <span class="cls">np</span>.<span class="fn">ones</span>(N) / N
    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(max_iter):
        pi_new = pi @ P_pr
        <span class="kw">if</span> <span class="cls">np</span>.linalg.<span class="fn">norm</span>(pi_new - pi, <span class="num">1</span>) < tol:
            <span class="fn">print</span>(f<span class="str">"收敛于第 {i+1} 次迭代"</span>)
            <span class="kw">break</span>
        pi = pi_new
    <span class="kw">return</span> pi / pi.<span class="fn">sum</span>()

<span class="com"># 4 个网页的链接结构</span>
A = <span class="cls">np</span>.<span class="fn">array</span>([
    [<span class="num">0</span>, <span class="num">1</span>, <span class="num">1</span>, <span class="num">0</span>],  <span class="com"># 页面 0 → 1, 2</span>
    [<span class="num">0</span>, <span class="num">0</span>, <span class="num">1</span>, <span class="num">1</span>],  <span class="com"># 页面 1 → 2, 3</span>
    [<span class="num">1</span>, <span class="num">0</span>, <span class="num">0</span>, <span class="num">0</span>],  <span class="com"># 页面 2 → 0</span>
    [<span class="num">0</span>, <span class="num">0</span>, <span class="num">1</span>, <span class="num">0</span>],  <span class="com"># 页面 3 → 2</span>
])
pr = <span class="fn">pagerank</span>(A)
<span class="fn">print</span>(f<span class="str">"PageRank: {pr}"</span>)
<span class="fn">print</span>(f<span class="str">"排名: {np.argsort(-pr)}"</span>)
</pre>
</div>

