(function() {
  var savedFormulas = [];
  document.querySelectorAll('.formula[data-eq]').forEach(function(f) {
    savedFormulas.push({ el: f, text: f.textContent, eq: f.getAttribute('data-eq') });
    f.innerHTML = '';
  });
  function renderAll() {
    if (typeof renderMathInElement === 'undefined' || typeof katex === 'undefined') { setTimeout(renderAll, 100); return; }
    renderMathInElement(document.body, { delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}, {left: '\\(', right: '\\)', display: false}], throwOnError: false });
    savedFormulas.forEach(function(item) {
      var f = item.el; var rawText = item.text; f.setAttribute('data-eq', item.eq);
      var body = document.createElement('div'); body.className = 'formula-body';
      body.style.cssText = 'flex:1;text-align:center;overflow-x:auto;overflow-y:hidden;padding:4px 0;';
      f.appendChild(body);
      var parts = rawText.split(/\$\$(.*?)\$\$/s); var isFormula = false;
      for (var i = 0; i < parts.length; i++) {
        if (isFormula && parts[i].trim()) {
          var eqDiv = document.createElement('div'); body.appendChild(eqDiv);
          try { katex.render(parts[i].trim(), eqDiv, { displayMode: true, throwOnError: false }); } catch(e) { eqDiv.textContent = parts[i]; }
        } else if (parts[i].trim()) { var span = document.createElement('span'); span.innerHTML = parts[i]; body.appendChild(span); }
        isFormula = !isFormula;
      }
    });
  }
  renderAll();
})();
</script>
