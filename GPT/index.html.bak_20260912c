<section id="ch11">
<h2><span class="num">11</span>PyTorch 代码实现</h2>

<h3>11.1 GPT Decoder Block</h3>
<div class="code-block">
<div class="code-header">Python — GPT Decoder Block (PyTorch)</div>
<pre><span class="kw">import</span> torch
<span class="kw">import</span> torch.nn <span class="kw">as</span> nn
<span class="kw">import</span> torch.nn.functional <span class="kw">as</span> F

<span class="kw">class</span> <span class="cls">GPTDecoderBlock</span>(nn.Module):
    <span class="kw">def</span> <span class="fn">__init__</span>(self, d_model, n_heads, d_ff, dropout=<span class="num">0.1</span>):
        <span class="fn">super</span>().<span class="fn">__init__</span>()
        self.n_heads = n_heads
        self.d_k = d_model // n_heads
        <span class="com"># 因果自注意力</span>
        self.w_q = nn.Linear(d_model, d_model)
        self.w_k = nn.Linear(d_model, d_model)
        self.w_v = nn.Linear(d_model, d_model)
        self.w_o = nn.Linear(d_model, d_model)
        <span class="com"># FFN</span>
        self.ffn = nn.Sequential(
            nn.Linear(d_model, d_ff),
            nn.GELU(),
            nn.Linear(d_ff, d_model),
        )
        <span class="com"># LayerNorm + Dropout</span>
        self.ln1 = nn.LayerNorm(d_model)
        self.ln2 = nn.LayerNorm(d_model)
        self.dropout = nn.Dropout(dropout)

    <span class="kw">def</span> <span class="fn">forward</span>(self, x, mask=<span class="kw">None</span>):
        <span class="com"># x: (batch, seq_len, d_model)</span>
        B, L, D = x.shape
        <span class="com"># 多头注意力</span>
        Q = self.w_q(x).view(B, L, self.n_heads, self.d_k).transpose(<span class="num">1</span>, <span class="num">2</span>)
        K = self.w_k(x).view(B, L, self.n_heads, self.d_k).transpose(<span class="num">1</span>, <span class="num">2</span>)
        V = self.w_v(x).view(B, L, self.n_heads, self.d_k).transpose(<span class="num">1</span>, <span class="num">2</span>)
        <span class="com"># 缩放点积注意力 + 因果掩码</span>
        scores = (Q @ K.transpose(-<span class="num">2</span>, -<span class="num">1</span>)) / (self.d_k ** <span class="num">0.5</span>)
        <span class="kw">if</span> mask <span class="kw">is</span> <span class="kw">None</span>:
            mask = torch.triu(torch.ones(L, L, device=x.device), diagonal=<span class="num">1</span>).bool()
        scores = scores.masked_fill(mask, float(<span class="str">'-inf'</span>))
        attn = F.softmax(scores, dim=-<span class="num">1</span>)
        out = attn @ V  <span class="com"># (B, n_heads, L, d_k)</span>
        out = out.transpose(<span class="num">1</span>, <span class="num">2</span>).contiguous().view(B, L, D)
        <span class="com"># 残差 + LayerNorm</span>
        x = self.ln1(x + self.dropout(self.w_o(out)))
        <span class="com"># FFN + 残差 + LayerNorm</span>
        x = self.ln2(x + self.dropout(self.ffn(x)))
        <span class="kw">return</span> x</pre>
</div>

<h3>11.2 完整 GPT 模型</h3>
<div class="code-block">
<div class="code-header">Python — GPT 模型 (PyTorch)</div>
<pre><span class="kw">class</span> <span class="cls">GPT</span>(nn.Module):
    <span class="kw">def</span> <span class="fn">__init__</span>(self, vocab_size, d_model, n_heads, d_ff, n_layers,
                 max_len=<span class="num">512</span>, dropout=<span class="num">0.1</span>):
        <span class="fn">super</span>().<span class="fn">__init__</span>()
        <span class="com"># Token + Position Embedding（权重共享）</span>
        self.tok_emb = nn.Embedding(vocab_size, d_model)
        self.pos_emb = nn.Embedding(max_len, d_model)
        self.dropout = nn.Dropout(dropout)
        <span class="com"># N 层 Decoder Block</span>
        self.layers = nn.ModuleList([
            GPTDecoderBlock(d_model, n_heads, d_ff, dropout)
            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(n_layers)
        ])
        self.ln_f = nn.LayerNorm(d_model)
        <span class="com"># 输出层与 tok_emb 共享权重</span>
        self.lm_head = nn.Linear(d_model, vocab_size, bias=<span class="kw">False</span>)
        self.lm_head.weight = self.tok_emb.weight  <span class="com"># 权重共享</span>

    <span class="kw">def</span> <span class="fn">forward</span>(self, x):
        <span class="com"># x: (batch, seq_len) token ids</span>
        B, L = x.shape
        pos = torch.arange(L, device=x.device).unsqueeze(<span class="num">0</span>)
        <span class="com"># Embedding</span>
        h = self.tok_emb(x) + self.pos_emb(pos)
        h = self.dropout(h)
        <span class="com"># Decoder Blocks</span>
        <span class="kw">for</span> layer <span class="kw">in</span> self.layers:
            h = layer(h)
        h = self.ln_f(h)
        <span class="com"># 输出 logits (batch, seq_len, vocab_size)</span>
        logits = self.lm_head(h)
        <span class="kw">return</span> logits</pre>
</div>

<h3>11.3 自回归生成</h3>
<div class="code-block">
<div class="code-header">Python — 文本生成 (Greedy + Top-k Sampling)</div>
<pre><span class="kw">def</span> <span class="fn">generate</span>(model, prompt_ids, max_new_tokens=<span class="num">100</span>,
             top_k=<span class="num">50</span>, temperature=<span class="num">0.8</span>):
    model.<span class="fn">eval</span>()
    <span class="kw">with</span> torch.no_grad():
        x = prompt_ids  <span class="com"># (1, prompt_len)</span>
        <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(max_new_tokens):
            <span class="com"># 取最后 max_len 个 token 作为上下文</span>
            x_ctx = x[:, -model.pos_emb.num_embeddings:]
            logits = model(x_ctx)  <span class="com"># (1, seq_len, vocab)</span>
            logits = logits[:, -<span class="num">1</span>, :] / temperature  <span class="com"># 最后一个位置</span>
            <span class="com"># Top-k 采样</span>
            <span class="kw">if</span> top_k > <span class="num">0</span>:
                v, _ = torch.topk(logits, top_k)
                logits[logits < v[:, [-<span class="num">1</span>]]] = float(<span class="str">'-inf'</span>)
            probs = F.softmax(logits, dim=-<span class="num">1</span>)
            next_id = torch.multinomial(probs, num_samples=<span class="num">1</span>)
            x = torch.cat([x, next_id], dim=<span class="num">1</span>)
    <span class="kw">return</span> x

<span class="com"># 使用示例</span>
<span class="com"># model = GPT(vocab_size=50257, d_model=768, n_heads=12, d_ff=3072, n_layers=12)</span>
<span class="com"># prompt = torch.tensor([[50256, 2068, 1000]])  # "Hello world"</span>
<span class="com"># output = generate(model, prompt, max_new_tokens=50)</span></pre>
</div>

<h3>11.4 预训练损失函数</h3>
<div class="code-block">
<div class="code-header">Python — 自回归预训练损失</div>
<pre><span class="kw">def</span> <span class="fn">autoregressive_loss</span>(logits, targets):
    <span class="com"># logits: (batch, seq_len, vocab_size)</span>
    <span class="com"># targets: (batch, seq_len) — 输入右移一位</span>
    <span class="com"># 忽略 padding token (假设 pad_id=-100)</span>
    loss = F.cross_entropy(
        logits.view(-<span class="num">1</span>, logits.size(-<span class="num">1</span>)),
        targets.view(-<span class="num">1</span>),
        ignore_index=-<span class="num">100</span>,
    )
    <span class="kw">return</span> loss

