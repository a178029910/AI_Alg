    <!-- CNN -->
    <a class="card" href="CNN/index.html" data-cat="deep" data-name="CNN 卷积神经网络 Convolutional Neural Network 卷积 池化 感受野" data-page-node-id="r5xzugOux9tuVYDxlTpeGr">
