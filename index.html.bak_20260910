    <!-- LinearAlgebra -->
    <a class="card" href="LinearAlgebra/index.html" data-cat="math" data-name="线性代数 Linear Algebra 矩阵 向量 基 坐标 变换 特征值 对角化 SVD QR分解 最小二乘 范数 条件数 特殊矩阵" data-page-node-id="DEB0WfXhGyJJ1hoyAAWSpv">
      <div class="icon cat-math" data-page-node-id="N1jgzlywS6ZqO3fXyMwVNd">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-page-node-id="EuHKvHV5eiQL1fFwqEVDGB"><path d="M3 3h18M3 21h18M3 3v18M21 3v18" opacity="0.3" data-page-node-id="4Xa1Qujfw89UlbdUGgT2BZ"/><path d="M7 8l4 8M17 8l-4 8M10 8h4M8 16h8" data-page-node-id="FVt2GbhpEBId03cUGPBa48"/></svg>
      </div>
      <h3 data-page-node-id="PFEY7zivSX2e6kPTBhca0p">线性代数</h3>
      <div class="en-name" data-page-node-id="HkJtyIn1DERgIMhj4cjreL">Linear Algebra · Matrices, Vectors, Eigenvalues & Decompositions</div>
      <p class="desc" data-page-node-id="VnShsHamqG1VRpfs4iItgd">从向量与矩阵运算出发，系统讲解基与坐标变换、特征值与矩阵分解（SVD/PCA/QR/LU/Cholesky）、正交化与最小二乘、范数与条件数、特殊矩阵与结构化矩阵，9 章完整知识体系。</p>
      <div class="tags" data-page-node-id="VM53SHmgmP3wrktZTb6Zx3"><span class="tag tag-blue" data-page-node-id="BXkGbDADOxFnopQr4CA81q">线性代数</span><span class="tag tag-purple" data-page-node-id="vPj0cMIDEkDsyK9EMAYXG1">矩阵分解</span><span class="tag tag-green" data-page-node-id="XC3bikboV2MeOvxQAnMZXJ">SVD</span><span class="tag tag-orange" data-page-node-id="KJJcIPetjlWusdxCWaRo0l">最小二乘</span></div>
      <div class="meta" data-page-node-id="Ljh0esJjQXFUYwBSHjV1WV"><span class="count" data-page-node-id="acnXXrm3va4xwHon2jlMIV">64 公式 / 3 SVG / 14 参考文献</span><span class="arrow" data-page-node-id="oJHJlayhtCGE9SrP1aJPfD">&#8594;</span></div>
    </a>

    <!-- Probability -->
    <a class="card" href="Probability/index.html" data-cat="math" data-name="概率论 Probability 贝叶斯 条件独立 随机变量 期望 方差 大数定律 中心极限定理 马尔可夫链 泊松过程 高斯过程 MCMC HMM 贝叶斯推断 共轭先验" data-page-node-id="x3dwiumrFA2cmAzABHJCL7">
      <div class="icon cat-math" data-page-node-id="Q78YBRi8xsXFaI5cDnXz41">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-page-node-id="j31W1cODIodlkBtR0Hrh9n"><path d="M3 21C6 21 6 3 12 3S18 21 21 21" opacity="0.3" data-page-node-id="MMwjYohlByBG7HHGqNBsXC"/><path d="M3 21h18" data-page-node-id="5opjwY6AMa76FiUZ9hQ7sL"/><path d="M5 18C8 18 8 6 12 6S16 18 19 18" data-page-node-id="BW0Nq6o6AxYOz29DXIxU5d"/><circle cx="12" cy="12" r="1.5" fill="currentColor" data-page-node-id="mNx62U9leEovK2BakCx2Aq"/></svg>
      </div>
      <h3 data-page-node-id="tinVkqKag3bx0i8g8zeyA8">概率论</h3>
      <div class="en-name" data-page-node-id="AY353PxrmmzfXAEyjSzHKz">Probability Theory · Bayes · Random Variables · Limit Theorems · Stochastic Processes</div>
      <p class="desc" data-page-node-id="cjaE4J8XTnun7r6c6mpIcn">从概率公理与贝叶斯定理出发，系统讲解条件独立、随机变量与分布、期望与方差性质、多元概率与极限定理、高级分布与贝叶斯推断、随机过程（马尔可夫链/泊松过程/高斯过程），7 章完整知识体系。</p>
      <div class="tags" data-page-node-id="LOoLIECgwY5E8Sod32mtpv"><span class="tag tag-blue" data-page-node-id="mVXMF5h8oGzlI8xIMIqXJA">概率论</span><span class="tag tag-purple" data-page-node-id="1g3aQlrZJ8PWXPAMEMHLZG">贝叶斯</span><span class="tag tag-green" data-page-node-id="IBjd6IvwXLMYAdIWtkph1x">极限定理</span><span class="tag tag-orange" data-page-node-id="PPx8UJ0zZcI51PRRqoGEcu">随机过程</span></div>
      <div class="meta" data-page-node-id="YlMc3r8rNwmXyqSrpQvcXk"><span class="count" data-page-node-id="ZdejZi1DDYGIe6pLqAMXaP">41 公式 / 5 SVG / 15 参考文献</span><span class="arrow" data-page-node-id="yYTgaS2QzcTTt1tY5LoIjm">&#8594;</span></div>
    </a>

    <!-- Calculus -->
    <a class="card" href="Calculus/index.html" data-cat="math" data-name="微积分与凸优化 Calculus 极限 连续 导数 链式法则 中值定理 泰勒展开 积分 级数 梯度 海森矩阵 雅可比 方向导数 全微分 凸集 凸函数 KKT 对偶 交叉熵 KL散度 信息熵 互信息 Adam SGD 牛顿法" data-page-node-id="g7RxS0CEAGgfvSGWa7AFBc">
      <div class="icon cat-math" data-page-node-id="UH2kPbosRpZMGWAReiO2sB">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-page-node-id="uBZbS7FsWnciDU8Ex8Yi9G"><path d="M3 20C6 20 9 4 12 4S18 20 21 20" opacity="0.3" data-page-node-id="A0ukR6c6Hpk6XpGGC4fRig"/><path d="M3 20h18" data-page-node-id="ib1WaiiifIlweBZu93UHbv"/><path d="M7 17l3-6 4 8 3-5" stroke-dasharray="2 2" opacity="0.6" data-page-node-id="f1AscJLvCDmGRKOi7VVixF"/><circle cx="10" cy="11" r="1.5" fill="currentColor" data-page-node-id="cnvPGd83DEXulIRtrMUFrc"/></svg>
      </div>
      <h3 data-page-node-id="7FwVlQsfGTb6biUGeQBk0G">微积分与凸优化</h3>
      <div class="en-name" data-page-node-id="S1CGpNPmaucYnHkcBEHnYt">Calculus & Convex Optimization · Limits · Gradients · KKT · Information Theory</div>
      <p class="desc" data-page-node-id="MDrMxxk6MSUXLBPbWz7ms7">从极限与连续出发，沿微积分主线（一元微分 → 积分级数 → 多元微积分）与优化主线（凸优化理论 → 优化算法）展开，以信息论收官，串联概率论 + 微积分 + 凸优化，9 章完整知识体系。</p>
      <div class="tags" data-page-node-id="9Oh24CIllfsQEhm9oeFLJx"><span class="tag tag-blue" data-page-node-id="ZO8YxUszE0SbuCqYD1VJej">微积分</span><span class="tag tag-purple" data-page-node-id="hlTVxx6fOYLwkakMKRsjhb">凸优化</span><span class="tag tag-green" data-page-node-id="PFNSJbZvuqcvL7YwdHZuKQ">信息论</span><span class="tag tag-orange" data-page-node-id="35BEeo2wdq7IJIPIj6VLlG">KKT</span></div>
      <div class="meta" data-page-node-id="IgP6WZDoXrhlH6Ra8oIpDt"><span class="count" data-page-node-id="sJ51RE1IxF0u0IKiijgwt5">36 公式 / 3 SVG / 14 参考文献</span><span class="arrow" data-page-node-id="kQwh3ewdFQBqmUoBbb5Vqz">&#8594;</span></div>
    </a>

    <!-- LearningParadigms -->
    <a class="card" href="LearningParadigms/index.html" data-cat="ml" data-name="学习范式 综述 有监督 无监督 半监督 自监督 弱监督 迁移学习 元学习 RLHF RLVR DPO FixMatch SimCLR MAE CLIP BERT 预训练 微调 对齐 大模型" data-page-node-id="BCm33e15C4IAATbKDTUHIz">
      <div class="icon cat-ml" data-page-node-id="TyGgBpImTZOVW2Ml7cBFXZ">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-page-node-id="evaWH3lPbRqytzfUCqwsAU"><circle cx="5" cy="6" r="2" data-page-node-id="IpJ54Z1gMRRU6Bb0JQAowL"/><circle cx="5" cy="18" r="2" data-page-node-id="Mnc9jXIFfZVZCwcf8aYHPQ"/><circle cx="12" cy="12" r="2" data-page-node-id="xwhLPH9kk3PfFAhUCu0A7F"/><circle cx="19" cy="6" r="2" data-page-node-id="4xQmCBy5UOEaCkf3NBvChb"/><circle cx="19" cy="18" r="2" data-page-node-id="0IeR90qkcqAAzbfZL1wn3z"/><path d="M7 6l3 6M7 18l3-6M14 12l3-6M14 12l3 6" data-page-node-id="Lq2p5hHDzeTJGpKCSeg5tL"/><path d="M5 8v8M19 8v8" stroke-dasharray="2 2" opacity="0.4" data-page-node-id="aCkbVUyuCjhxWTnypNIT9n"/></svg>
      </div>
      <h3 data-page-node-id="wMoJKa8KcXTAHY8FhznYD0">机器学习范式综述</h3>
      <div class="en-name" data-page-node-id="qHbxlkgqcVcJxWOTgVfthQ">Learning Paradigms Review · Supervised · Unsupervised · SSL · Self-Supervised</div>
      <p class="desc" data-page-node-id="1CDGjFVnNMwNcEAF4TBhSy">系统综述有监督、无监督、半监督、自监督、弱监督、迁移与元学习六大范式，涵盖基本原理、核心公式与 2024-2025 前沿新技术（RLHF/RLVR/DPO、FixMatch、I-JEPA、扩散模型、异构半监督等），附选型决策流程与演进时间线。</p>
      <div class="tags" data-page-node-id="iCnxbP7dmw2nVivUJFHDfb"><span class="tag tag-red" data-page-node-id="Twng2k8wd13GXfV3PkhutC">机器学习</span><span class="tag tag-blue" data-page-node-id="S7h6PpimCPOFrEaTcMTRAs">综述</span><span class="tag tag-purple" data-page-node-id="cdE4aGAkDDjwYTUosWnZvr">范式</span><span class="tag tag-green" data-page-node-id="jMQIXv5FzaGYSJEP8cLrhC">2025前沿</span></div>
      <div class="meta" data-page-node-id="vIIegChh4vth6IF2u9K1Gk"><span class="count" data-page-node-id="B4seZ4A9OGGboWmxSTugvQ">14 公式 / 3 SVG / 2 代码</span><span class="arrow" data-page-node-id="LqAPuDEpFKAxUDysiQDxfY">&#8594;</span></div>
    </a>

