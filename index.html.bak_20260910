<footer class="footer" data-page-node-id="hpXaKTZOX1hV2nxnsQPIRZ">
  人工智能算法精华介绍系列技术文档 By SanJoseCN
</footer>

<script>
// 分类筛选
const filterBtns = document.querySelectorAll('.filter-btn');
const cards = document.querySelectorAll('.card');
const resultTitle = document.getElementById('resultTitle');
  const catNames = { all: '全部算法', math: '数学基础', ml: '机器学习', prob: '随机过程', deep: '深度学习', cv: '计算机视觉', nlp: '自然语言处理', graph: '图学习', rl: '强化学习' };

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const cat = btn.dataset.cat;
    let count = 0;
    cards.forEach(card => {
      const match = cat === 'all' || card.dataset.cat === cat;
      card.style.display = match ? '' : 'none';
      if (match) count++;
    });
    resultTitle.textContent = catNames[cat] + ' (' + count + ')';
  });
});

// 搜索
const searchInput = document.getElementById('searchInput');
searchInput.addEventListener('input', () => {
  const q = searchInput.value.toLowerCase().trim();
  const activeCat = document.querySelector('.filter-btn.active').dataset.cat;
  let count = 0;
  cards.forEach(card => {
    const catMatch = activeCat === 'all' || card.dataset.cat === activeCat;
    const nameMatch = q === '' || card.dataset.name.toLowerCase().includes(q);
    const show = catMatch && nameMatch;
    card.style.display = show ? '' : 'none';
    if (show) count++;
  });
  resultTitle.textContent = (activeCat === 'all' ? '全部算法' : catNames[activeCat]) + ' (' + count + ')';
});
</script>
</body>
</html>
