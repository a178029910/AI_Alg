    </a>

    <!-- Graphormer -->
    <a class="card" href="Graphormer/index.html" data-cat="graph" data-name="Graphormer 图Transformer 图 Transformer Centrality Encoding Spatial Encoding 注意力 图学习" data-page-node-id="MEuNEKpswrtnTipVPlHOkU">
      <div class="icon cat-graph" data-page-node-id="0LtKNvh9m9IpnvXRMacxDM">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-page-node-id="8Y3dPWrjDk2djfyAiwz2YH"><circle cx="5" cy="7" r="2" data-page-node-id="IMtlG0FLdCUThBSA2VgB51"/><circle cx="19" cy="7" r="2" data-page-node-id="Jyl7KcsQ5hLnb7ZdtqEwQA"/><circle cx="12" cy="17" r="2" data-page-node-id="6aIGeDBoxECUm7nZjDCUe8"/><circle cx="5" cy="17" r="2" data-page-node-id="tykqWUgP7LVmO1ygTRFqQl"/><circle cx="19" cy="17" r="2" data-page-node-id="oWOyyY5VGbFfoefvgx6wjA"/><path d="M7 7h5M14 7h3M7 17h3M14 17h3M12 9v6" data-page-node-id="OrFxW0PBsrLgAciSHP1ikK"/><path d="M5 9v6M19 9v6" opacity="0.4" stroke-dasharray="2 2" data-page-node-id="7LxABEwLQpoFYDLGws2sA2"/></svg>
