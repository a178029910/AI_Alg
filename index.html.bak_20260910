<!DOCTYPE html>
<html lang="zh-CN" data-page-node-id="Ca2hZXjp12fvzgyU1BcGdZ">
<head data-page-node-id="Rq8JFKU75DDtfdHtD3DWrz">
<meta charset="UTF-8" data-page-node-id="iOJomKq8RfMHa9MU5x8iNo">
<meta name="viewport" content="width=device-width, initial-scale=1.0" data-page-node-id="GA4wHf5D7YRDML3GfwXHMJ">
<title>人工智能算法精华介绍 — 算法总览</title>
<link rel="icon" type="image/png" href="favicon.png" data-page-node-id="rfK7IPpv4ZwNIHtZJEECcb">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --c-bg: #f7f9fc; --c-bg-soft: #ffffff; --c-bg-card: #ffffff;
  --c-border: #e2e8f0; --c-border-strong: #cbd5e1;
  --c-text: #334155; --c-text-soft: #64748b; --c-text-faint: #94a3b8;
  --c-primary: #2563eb; --c-primary-dark: #1d4ed8; --c-primary-light: #dbeafe;
  --c-accent: #7c3aed; --c-accent-light: #ede9fe;
  --c-accent2: #059669; --c-accent2-light: #d1fae5;
  --c-warn: #ea580c; --c-warn-light: #ffedd5;
  --c-danger: #dc2626; --c-danger-light: #fee2e2;
  --c-heading: #0f172a;
  --radius-sm: 8px; --radius-md: 12px; --radius-lg: 16px; --radius-xl: 20px;
  --font-body: -apple-system, 'Segoe UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-mono: 'Cascadia Code', 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 4px 6px rgba(0,0,0,0.05), 0 2px 4px rgba(0,0,0,0.04);
  --shadow-lg: 0 10px 15px rgba(0,0,0,0.06), 0 4px 6px rgba(0,0,0,0.04);
  --shadow-xl: 0 20px 25px rgba(0,0,0,0.08), 0 10px 10px rgba(0,0,0,0.04);
}
html { scroll-behavior: smooth; font-size: 16px; }
body { font-family: var(--font-body); background: var(--c-bg); color: var(--c-text); line-height: 1.75; font-size: 16px; -webkit-font-smoothing: antialiased; }

/* Hero */
.hero { text-align: center; padding: 80px 24px 60px; background: linear-gradient(135deg, #eff6ff 0%, #ede9fe 50%, #ecfeff 100%); border-bottom: 1px solid var(--c-border); position: relative; overflow: hidden; }
.hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 30% 50%, rgba(37,99,235,0.06) 0%, transparent 50%), radial-gradient(circle at 70% 50%, rgba(124,58,237,0.04) 0%, transparent 50%); }
.hero h1 { font-size: clamp(32px, 6vw, 48px); font-weight: 800; color: var(--c-heading); position: relative; letter-spacing: 1px; margin-bottom: 16px; }
.hero .subtitle { font-size: clamp(16px, 2.5vw, 20px); color: var(--c-primary); position: relative; margin-bottom: 12px; font-weight: 500; }
.hero .tagline { font-size: 14px; color: var(--c-text-soft); position: relative; }

/* Filter Bar */
.filter-bar { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--c-border); padding: 16px 24px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center; box-shadow: var(--shadow-sm); }
.filter-bar .label { font-size: 14px; color: var(--c-text-soft); font-weight: 600; margin-right: 4px; }
.filter-btn { padding: 8px 18px; border-radius: 20px; border: 1px solid var(--c-border-strong); background: var(--c-bg-soft); color: var(--c-text-soft); font-size: 14px; cursor: pointer; transition: all 0.2s ease; font-family: var(--font-body); font-weight: 500; }
.filter-btn:hover { border-color: var(--c-primary); color: var(--c-primary); background: var(--c-primary-light); }
.filter-btn.active { background: linear-gradient(135deg, var(--c-primary), var(--c-accent)); color: #fff; border-color: transparent; box-shadow: var(--shadow-sm); }

/* Grid */
.container { max-width: 1200px; margin: 0 auto; padding: 48px 24px; }
.section-title { font-size: 24px; color: var(--c-heading); font-weight: 700; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; }
.section-title::before { content: ''; width: 4px; height: 28px; border-radius: 2px; background: linear-gradient(135deg, var(--c-primary), var(--c-accent)); }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }

/* Card */
.card { background: var(--c-bg-card); border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 28px; box-shadow: var(--shadow-sm); transition: all 0.3s ease; cursor: pointer; text-decoration: none; color: inherit; display: flex; flex-direction: column; position: relative; overflow: hidden; }
.card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--c-primary), var(--c-accent)); transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease; }
.card:hover { transform: translateY(-4px); box-shadow: var(--shadow-xl); border-color: var(--c-border-strong); }
.card:hover::before { transform: scaleX(1); }
.card .icon { width: 56px; height: 56px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 16px; flex-shrink: 0; }
.card .icon svg { width: 32px; height: 32px; }
.card h3 { font-size: 20px; color: var(--c-heading); font-weight: 700; margin-bottom: 6px; }
.card .en-name { font-size: 13px; color: var(--c-text-faint); font-family: var(--font-mono); margin-bottom: 12px; }
.card .desc { font-size: 14px; color: var(--c-text-soft); line-height: 1.7; margin-bottom: 16px; flex: 1; }
.card .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
.card .tag { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; }
.tag-blue { background: var(--c-primary-light); color: var(--c-primary-dark); }
.tag-green { background: var(--c-accent2-light); color: var(--c-accent2); }
.tag-orange { background: var(--c-warn-light); color: var(--c-warn); }
.tag-purple { background: var(--c-accent-light); color: var(--c-accent); }
.tag-red { background: var(--c-danger-light); color: var(--c-danger); }
.card .meta { display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid var(--c-border); }
.card .meta .count { font-size: 13px; color: var(--c-text-faint); }
.card .meta .arrow { font-size: 20px; color: var(--c-primary); transition: transform 0.2s ease; }
.card:hover .meta .arrow { transform: translateX(4px); }

/* Category colors */
.cat-deep { background: linear-gradient(135deg, #dbeafe, #ede9fe); }
.cat-deep svg { color: #2563eb; }
.cat-cv { background: linear-gradient(135deg, #d1fae5, #ecfdf5); }
.cat-cv svg { color: #059669; }
.cat-nlp { background: linear-gradient(135deg, #ffedd5, #fff7ed); }
.cat-nlp svg { color: #ea580c; }
.cat-ml { background: linear-gradient(135deg, #fee2e2, #fef2f2); }
.cat-ml svg { color: #dc2626; }
.cat-graph { background: linear-gradient(135deg, #ede9fe, #f5f3ff); }
.cat-graph svg { color: #7c3aed; }
.cat-prob { background: linear-gradient(135deg, #e0f2fe, #f0f9ff); }
.cat-prob svg { color: #0284c7; }
.cat-math { background: linear-gradient(135deg, #fef3c7, #fefce8); }
.cat-math svg { color: #d97706; }

/* Search */
.search-box { margin: 0 auto 32px; max-width: 480px; position: relative; }
.search-box input { width: 100%; padding: 12px 20px 12px 44px; border: 1px solid var(--c-border-strong); border-radius: 24px; font-size: 15px; font-family: var(--font-body); background: var(--c-bg-soft); box-shadow: var(--shadow-sm); transition: all 0.2s ease; }
.search-box input:focus { outline: none; border-color: var(--c-primary); box-shadow: 0 0 0 3px var(--c-primary-light); }
.search-box .search-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--c-text-faint); font-size: 18px; }

/* Footer */
.footer { text-align: center; padding: 48px 24px; color: var(--c-text-faint); font-size: 13px; border-top: 1px solid var(--c-border); }

/* Responsive */
@media (max-width: 900px) { .grid { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); } }
@media (max-width: 600px) { .grid { grid-template-columns: 1fr; } .container { padding: 32px 16px; } .filter-bar { padding: 12px 16px; } .filter-btn { font-size: 13px; padding: 6px 14px; } }
</style>
</head>
