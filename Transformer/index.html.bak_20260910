  <!-- Add 1 -->
  <circle cx="240" cy="231" r="10" fill="#d1fae5" stroke="#059669" stroke-width="1.5"/>
  <text x="240" y="235" text-anchor="middle" fill="#059669" font-weight="700" font-size="11">+</text>
  <line x1="240" y1="221" x2="240" y2="221" stroke="#64748b" stroke-width="1"/>
  <line x1="240" y1="241" x2="240" y2="251" stroke="#64748b" stroke-width="1" marker-end="url(#ah5)"/>
  <!-- LayerNorm 2 -->
  <rect x="170" y="256" width="140" height="30" rx="6" fill="#ffedd5" stroke="#ea580c" stroke-width="1.5"/>
  <text x="240" y="277" text-anchor="middle" fill="#ea580c" font-weight="600" font-size="10">LayerNorm</text>
  <line x1="240" y1="286" x2="240" y2="296" stroke="#64748b" stroke-width="1" marker-end="url(#ah5)"/>
