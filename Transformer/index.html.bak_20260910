  <!-- Arrow -->
  <line x1="210" y1="200" x2="250" y2="200" stroke="#64748b" stroke-width="2" marker-end="url(#ah6)"/>
  <text x="230" y="192" text-anchor="middle" fill="#64748b" font-size="9">缓存传递</text>
  <!-- Step t -->
  <rect x="260" y="42" width="200" height="270" rx="10" fill="rgba(234,88,12,0.04)" stroke="#ea580c" stroke-width="1.5" stroke-dasharray="4,3"/>
  <text x="365" y="78" text-anchor="middle" fill="#ea580c" font-weight="700" font-size="11">Step t（仅处理新 token）</text>
  <rect x="300" y="95" width="110" height="28" rx="4" fill="#ffedd5" stroke="#ea580c" stroke-width="1"/>
  <text x="355" y="114" text-anchor="middle" fill="#ea580c" font-size="10" font-weight="600">token t（仅 1 个）</text>
  <rect x="290" y="142" width="140" height="26" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"/>
  <text x="360" y="160" text-anchor="middle" fill="#7c3aed" font-size="9">Self-Attn（Q=token_t）</text>
  <rect x="290" y="185" width="65" height="30" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"/>
  <text x="322" y="199" text-anchor="middle" fill="#7c3aed" font-size="9" font-weight="600">K cache</text>
  <text x="322" y="211" text-anchor="middle" fill="#64748b" font-size="8">+ 新 token</text>
  <rect x="365" y="185" width="65" height="30" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"/>
  <text x="397" y="199" text-anchor="middle" fill="#7c3aed" font-size="9" font-weight="600">V cache</text>
  <text x="397" y="211" text-anchor="middle" fill="#64748b" font-size="8">+ 新 token</text>
  <rect x="300" y="230" width="110" height="26" rx="4" fill="#d1fae5" stroke="#059669" stroke-width="1"/>
  <text x="355" y="248" text-anchor="middle" fill="#059669" font-size="9">输出 token t</text>
  <text x="360" y="288" text-anchor="middle" fill="#ea580c" font-size="9" font-weight="600">仅增量计算：O(t)（累计）</text>
  <!-- Contrast: Without cache -->
  <rect x="500" y="42" width="110" height="270" rx="10" fill="rgba(220,38,38,0.03)" stroke="#dc2626" stroke-width="1" stroke-dasharray="4,3"/>
