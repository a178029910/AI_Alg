  <!-- Arrow encoder → decoder cross-attn (K, V) -->
  <line x1="490" y1="385" x2="530" y2="385" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="4,2"/>
  <line x1="530" y1="385" x2="530" y2="545" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="4,2"/>
  <line x1="530" y1="545" x2="476" y2="545" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="4,2" marker-end="url(#ah)"/>
  <text x="540" y="470" text-anchor="middle" fill="#7c3aed" font-size="10" font-weight="600" transform="rotate(90 540 470)">K, V</text>
