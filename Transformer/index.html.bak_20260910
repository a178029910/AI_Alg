  <text x="395" y="503" text-anchor="middle" fill="#64748b" font-size="10">+ Add &amp; LayerNorm</text>
  <rect x="320" y="525" width="150" height="44" rx="6" fill="#ede9fe" stroke="#7c3aed" stroke-width="1.5"/>
  <text x="395" y="543" text-anchor="middle" fill="#7c3aed" font-weight="600" font-size="11">Cross-Attention</text>
  <text x="395" y="559" text-anchor="middle" fill="#64748b" font-size="9">Q: decoder · K,V: encoder</text>
